---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import Categories from '../components/Categories.astro';
import Lookbook from '../components/Lookbook.astro';
import catalog from '../data/catalog.json';
import { whatsappHref } from '../lib/store';
---
<Base
  title="Kids' Wear in Wandoor | Frocks, Party & Western Wear | Kiddy Zone"
  description="Imported kids' clothing and accessories at Kiddy Zone, Wandoor. Frocks, party wear, western wear, footwear and baby sets on C H Bypass Road, Malappuram."
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: "Kids' wear", path: '/kids-wear' }]}
>
  <section class="wrap" style="padding-block:1.5rem 3rem">
    <h1>Kids' wear</h1>
    <p class="lede">Imported kids' clothing and accessories in Wandoor. Tap a category, or tell us the age and the occasion and we'll tell you what's available.</p>
    <ul class="tiles six">
      {catalog.wear.map((c) => (
        <li><a class="tile" href={`#${c.id}`}><span class={`tile-frame bg-${c.colour}`}><Art name={c.art} /></span><span class="tile-name">{c.name.split(' & ')[0].replace("Kids' a", 'A')}</span></a></li>
      ))}
    </ul>
  </section>
  <section style="padding-bottom:3rem">
    <div class="wrap center">
      <p class="script">Little looks</p>
      <h2>From our lookbook</h2>
    </div>
    <Lookbook />
  </section>
  <section class="wrap" style="padding-bottom:3rem">
    <Categories categories={catalog.wear} />
    <div class="callout">
      <h2>Function coming up?</h2>
      <p>Tell us the date, the child's age and what they like to wear. It helps to ask early.</p>
      <a class="btn btn-wa" href={whatsappHref("Hi Kiddy Zone, I'm looking for an outfit for a function. My child's age is ")}>Message us on WhatsApp</a>
    </div>
  </section>
</Base>
