---
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource-variable/lora';
import '@fontsource/great-vibes/latin-400.css';
import '@fontsource/noto-serif-malayalam/malayalam-500.css';
import '../styles/global.css';
import { store, addressLine, telHref, directionsHref, whatsappHref, storeSchema, breadcrumbSchema } from '../lib/store';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  breadcrumbs?: { name: string; path: string }[];
  schema?: object[];
}
const { title, description, ogType = 'website', breadcrumbs, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', store.url).href;
const ogImage = `${store.url}/og.png`;
const ld = [storeSchema(), ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs)] : []), ...schema];
const nav = [
  { href: '/', label: 'Home' },
  { href: '/kids-wear', label: "Kids' wear" },
  { href: '/toys', label: 'Toys & rides' },
  { href: '/blog', label: 'Notes' },
  { href: '/about', label: 'About us' },
  { href: '/visit', label: 'Visit' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f6e4e0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={store.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="The Kiddy Zone shopfront on Bypass Road, Wandoor" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="geo.region" content="IN-KL" />
    <meta name="geo.placename" content="Wandoor, Malappuram" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <p class="announce"><a href={whatsappHref()}>The complete kids shop · Bypass Road, Wandoor · {store.phone}</a></p>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="wordmark" href="/" aria-label="Kiddy Zone, the complete kids shop: home">
          <img src="/images/logo.webp" alt="Kiddy Zone, the complete kids shop" width="768" height="272" />
        </a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={(n.href === '/' ? path === '' : path === n.href || path.startsWith(`${n.href}/`)) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="head-icons">
          <a href={directionsHref} aria-label="Directions to the shop"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></a>
          <a href={telHref} aria-label={`Call ${store.phone}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 5.2 5.2l1.4-2.1 4.2 1.6V17a2.5 2.5 0 0 1-2.5 2.5A14.5 14.5 0 0 1 2.5 6 2.5 2.5 0 0 1 5 3.5z"/></svg></a>
          <a href={whatsappHref()} aria-label="WhatsApp the shop"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 20l1.2-3.8A8.5 8.5 0 1 1 8 19z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.6-2-1-1 1a4.5 4.5 0 0 1-3-3l1-1-1-2z"/></svg></a>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div>
          <img class="foot-logo" src="/images/logo.webp" alt="Kiddy Zone, the complete kids shop" width="768" height="272" loading="lazy" />
          <p class="foot-ml" lang="ml">{store.taglineMl}</p>
          <p>{addressLine}</p>
        </div>
        <div>
          <h2>Talk to the shop</h2>
          <ul>
            <li><a href={telHref}>{store.phone}</a></li>
            <li><a href={whatsappHref()}>WhatsApp</a></li>
            <li><a href={`mailto:${store.email}`}>Email</a></li>
            <li><a href={store.instagram}>Instagram {store.instagramHandle}</a></li>
          </ul>
        </div>
        <div>
          <h2>Around the site</h2>
          <ul>
            <li><a href="/kids-wear">Kids' wear</a></li>
            <li><a href="/toys">Toys &amp; gifts</a></li>
            <li><a href="/about">About the shop</a></li>
            <li><a href="/blog">Notes for parents</a></li>
            <li><a href="/visit">Find us in Wandoor</a></li>
            <li><a href="/privacy">Privacy</a></li>
          </ul>
        </div>
      </div>
      <p class="wrap foot-small">© {new Date().getFullYear()} {store.legalName}</p>
    </footer>
    <div class="action-bar" role="group" aria-label="Contact the shop">
      <a href={telHref}>Call</a>
      <a href={whatsappHref()} class="is-wa">WhatsApp</a>
      <a href={directionsHref}>Directions</a>
    </div>
  </body>
</html>
