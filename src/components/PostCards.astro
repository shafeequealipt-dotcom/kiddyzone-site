---
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
const fmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<ul class="posts">
  {posts.map((p) => (
    <li>
      <a class="post-card" href={`/blog/${p.id}`}>
        <time class="post-date" datetime={p.data.pubDate.toISOString().slice(0, 10)}>{fmt.format(p.data.pubDate)}</time>
        <h3>{p.data.title}</h3>
        <p>{p.data.description}</p>
      </a>
    </li>
  ))}
</ul>
